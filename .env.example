# Copy to .env and edit. Every value is optional for local development.
APP_NAME=PENDEL
HOST=127.0.0.1
PORT=8000
PUBLIC_URL=http://localhost:8000
# SECRET_KEY=generate-a-long-random-string   (auto-generated into data/.secret_key if empty)

# First super admin (created on first start only). CHANGE THE PASSWORD after logging in.
ADMIN_EMAIL=admin@pendel.local
ADMIN_PASSWORD=Admin@12345
SEED_DEMO=true

# Storage: local (default) or s3 (AWS S3, Cloudflare R2, Wasabi, MinIO, DigitalOcean Spaces)
STORAGE_DRIVER=local
# S3_BUCKET=pendel-media
# S3_REGION=ap-south-1
# S3_ENDPOINT=                 # e.g. https://<account>.r2.cloudflarestorage.com ; empty = AWS
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# CDN_BASE_URL=https://cdn.example.com   # public artwork via CDN; audio always uses signed URLs

# Google sign-in: create an OAuth "Web application" client ID in Google Cloud Console,
# add your site origin to "Authorised JavaScript origins".
# GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# Payments. "sandbox" = simulated checkout, no money moves. Remove it in production.
PAYMENT_PROVIDERS=sandbox
# PAYMENT_PROVIDERS=razorpay
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
CURRENCY=INR

# FFMPEG_PATH=ffmpeg   # needed for automatic highlight detection and preview cutting on upload

# World catalogue (v2): real songs via Apple's free iTunes Search API, full songs via YouTube
WORLD_CATALOG=true
WORLD_COUNTRY=IN          # Apple storefront for search and the home chart
WORLD_WARMUP=true         # slowly pre-load popular language/mood lists after start-up
# YOUTUBE_API_KEY=        # free key from Google Cloud (YouTube Data API v3): imports 50,000+ full songs (Admin > YouTube catalogue)
